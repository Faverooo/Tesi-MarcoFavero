@startuml uc5
left to right direction
skinparam backgroundColor white
skinparam usecase {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor #555555
}

actor "Operatore" as op

rectangle "UC5 - Esportazione piano in formato JSON" {
    (UC5\nEsportazione piano\nin formato JSON) as UC5
    (UC5.E1\nGestione errore\nscrittura su disco) as UC5E1
}

op --> UC5
UC5E1 ..> UC5 : <<extend>>
@enduml
