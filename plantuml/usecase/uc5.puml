@startuml uc5
left to right direction
skinparam backgroundColor white
skinparam usecase {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor #555555
}

actor "Operatore" as op

rectangle "UC5 - Gestione storico pianificazioni" {
    (UC5\nGestione storico\npianificazioni) as UC5
    (UC5.1\nConsultazione elenco\nstorico pianificazioni) as UC51
    (UC5.2\nConsultazione dettaglio\nesecuzione storica) as UC52
}

op --> UC5
UC5 ..> UC51 : <<include>>
UC5 ..> UC52 : <<include>>

note bottom of UC52
  Precondizione: l'Operatore
  deve trovarsi nell'elenco
  storico (UC5.1)
end note
@enduml
