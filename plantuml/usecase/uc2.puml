@startuml uc2
left to right direction
skinparam backgroundColor white
skinparam usecase {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor #555555
}

actor "Operatore" as op

rectangle "UC2 - Avvio pianificazione" {
    (UC2\nAvvio\npianificazione) as UC2
    (UC2.E1\nGestione soluzione\nnon ammissibile) as UC2E1
}

op --> UC2
UC2E1 ..> UC2 : <<extend>>
@enduml
