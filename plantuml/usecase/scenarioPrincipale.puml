@startuml scenarioPrincipale
left to right direction
skinparam backgroundColor white
skinparam usecase {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor #555555
}

actor "Operatore" as op
actor "Sistema ERP" as erp

rectangle "Sistema di pianificazione produzione" {
    (UC1\nConfigurazione\npianificazione) as UC1
    (UC2\nAvvio\npianificazione) as UC2
    (UC3\nMonitoraggio\nesecuzione) as UC3
    (UC4\nConsultazione\nrisultati) as UC4
    (UC5\nGestione\nstorico) as UC5
    (UC6\nModifica\npriorita operative) as UC6
    (UC7\nStima ATP\nnuovo ordine) as UC7
    (UC8\nConsultazione stato\nrun via API) as UC8
    
    ' --- TRUCCO PER L'ORDINE VERTICALE IN LEFT-TO-RIGHT ---
    ' Usiamo "right" perché la direzione principale è ruotata
    UC1 -[hidden]left-> UC2
    UC3 -[hidden]left-> UC4
    UC4 -[hidden]left-> UC5
    UC5 -[hidden]left-> UC6
    UC6 -[hidden]left-> UC7
    UC7 -[hidden]left-> UC2
    UC2 -[hidden]left-> UC8
}

op --> UC1
op --> UC2
op --> UC3
op --> UC4
op --> UC5
op --> UC6
op --> UC7

erp --> UC2
erp --> UC8

@enduml