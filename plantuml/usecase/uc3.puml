@startuml uc3
left to right direction
skinparam backgroundColor white
skinparam usecase {
    BackgroundColor White
    BorderColor #555555
    ArrowColor #555555
    FontSize 11
}
skinparam actor {
    BackgroundColor White
    BorderColor #555555
}

actor "Operatore" as op

rectangle "UC3 - Monitoraggio esecuzione" {
    (UC3\nMonitoraggio\nesecuzione) as UC3
    (UC3.1\nConsultazione\nlog di esecuzione) as UC31
    (UC3.2\nConsultazione\nKPI in tempo reale) as UC32
    (UC3.3\nConsultazione\ntelemetria del solver) as UC33
    
    ' Ancoraggio verticale per i sotto-casi
    UC31 -[hidden]left-> UC32
    UC32 -[hidden]left-> UC33
}

op --> UC3
UC3 ..> UC31 : <<include>>
UC3 ..> UC32 : <<include>>
UC3 ..> UC33 : <<include>>
@enduml